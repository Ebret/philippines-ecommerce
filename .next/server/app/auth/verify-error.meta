{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/auth/layout,_N_T_/auth/verify-error/layout,_N_T_/auth/verify-error/page,_N_T_/auth/verify-error"
  },
  "segmentPaths": [
